{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "issuer",
    "canonical_url",
    "description",
    "credential_type",
    "entity_type",
    "assessment_required",
    "assessment_type",
    "verification_available",
    "access_or_exam_model",
    "related_course_ids",
    "prompt_engineering_relevance",
    "relevance_rationale",
    "validity_or_renewal",
    "status",
    "last_verified",
    "stale_after_days",
    "stale_risk"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^credential-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "issuer": {
      "type": "string",
      "minLength": 2
    },
    "canonical_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "description": {
      "type": "string",
      "minLength": 40
    },
    "credential_type": {
      "enum": [
        "formal_certification",
        "assessed_skill_credential",
        "applied_skill_credential",
        "skill_badge",
        "digital_badge",
        "completion_certificate",
        "professional_certificate_program"
      ]
    },
    "entity_type": {
      "enum": [
        "individual_credential",
        "credential_family",
        "program",
        "overview_resource"
      ]
    },
    "assessment_required": {
      "type": "boolean"
    },
    "assessment_type": {
      "enum": ["exam", "lab_assessment", "quiz", "mixed", "none", "unknown"]
    },
    "verification_available": {
      "enum": ["yes", "no", "unknown"]
    },
    "access_or_exam_model": {
      "enum": [
        "free",
        "free_with_account",
        "paid_exam",
        "paid_one_time",
        "subscription",
        "lab_credits",
        "freemium",
        "region_dependent",
        "unknown"
      ]
    },
    "related_course_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^course-[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "prompt_engineering_relevance": {
      "enum": ["direct", "substantial_component", "adjacent", "broad_ai"]
    },
    "relevance_rationale": {
      "type": "string",
      "minLength": 24
    },
    "validity_or_renewal": {
      "type": "string",
      "minLength": 8
    },
    "status": {
      "enum": ["active", "maintenance", "deprecated"]
    },
    "last_verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "stale_after_days": {
      "type": "integer",
      "minimum": 1
    },
    "stale_risk": {
      "enum": ["low", "medium", "high"]
    }
  }
}
