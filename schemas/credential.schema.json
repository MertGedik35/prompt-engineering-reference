{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "issuer",
    "canonical_url",
    "description",
    "credential_type",
    "entity_type",
    "assessment_required",
    "assessment_type",
    "verification",
    "access_or_exam_model",
    "related_courses",
    "prompt_engineering_relevance",
    "relevance_rationale",
    "validity_summary",
    "status",
    "last_verified",
    "stale_after_days",
    "stale_risk"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^credential-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "issuer": {
      "type": "string",
      "minLength": 2
    },
    "canonical_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "description": {
      "type": "string",
      "minLength": 40
    },
    "credential_type": {
      "enum": [
        "formal_certification",
        "assessed_skill_credential",
        "applied_skill_credential",
        "skill_badge",
        "digital_badge",
        "completion_certificate",
        "professional_certificate_program"
      ]
    },
    "entity_type": {
      "enum": [
        "individual_credential",
        "credential_family",
        "program",
        "overview_resource"
      ]
    },
    "assessment_required": {
      "type": "boolean"
    },
    "assessment_type": {
      "enum": ["exam", "lab_assessment", "quiz", "mixed", "none", "unknown"]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available"],
      "properties": {
        "available": {
          "enum": [true, false, "unknown"]
        },
        "method": {
          "type": "string",
          "minLength": 8
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "available": { "const": true } },
            "required": ["available"]
          },
          "then": {
            "required": ["method"]
          }
        },
        {
          "if": {
            "properties": { "available": { "enum": [false, "unknown"] } },
            "required": ["available"]
          },
          "then": {
            "not": {
              "required": ["method"]
            }
          }
        }
      ]
    },
    "access_or_exam_model": {
      "enum": [
        "free",
        "free_with_account",
        "paid_exam",
        "paid_one_time",
        "subscription",
        "lab_credits",
        "freemium",
        "region_dependent",
        "unknown"
      ]
    },
    "related_courses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["course_id", "relationship"],
        "properties": {
          "course_id": {
            "type": "string",
            "pattern": "^course-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "relationship": {
            "enum": [
              "produces",
              "official_preparation",
              "recommended_learning",
              "part_of",
              "overview_of"
            ]
          }
        }
      }
    },
    "prompt_engineering_relevance": {
      "enum": ["direct", "substantial_component", "adjacent", "broad_ai"]
    },
    "relevance_rationale": {
      "type": "string",
      "minLength": 24
    },
    "validity_summary": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "enum": ["active", "maintenance", "deprecated"]
    },
    "last_verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "stale_after_days": {
      "type": "integer",
      "minimum": 1
    },
    "stale_risk": {
      "enum": ["low", "medium", "high"]
    }
  }
}
