{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reusable prompt template",
  "type": "object",
  "required": [
    "id",
    "category",
    "variables",
    "required_inputs",
    "acceptance_criteria"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^template-[a-z0-9-]+-\\d{2}$"
    },
    "variables": {
      "type": "array",
      "minItems": 1
    },
    "required_inputs": {
      "type": "array",
      "minItems": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1
    }
  }
}
