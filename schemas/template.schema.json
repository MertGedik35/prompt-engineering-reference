{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "related_pattern",
    "variables",
    "required_inputs",
    "prompt",
    "expected_outputs",
    "acceptance_criteria",
    "failure_modes",
    "last_reviewed"
  ],
  "properties": {
    "id": {
      "pattern": "^template-[a-z0-9-]+$",
      "type": "string"
    },
    "variables": {
      "type": "array",
      "minItems": 3
    },
    "prompt": {
      "type": "string",
      "minLength": 250
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 3
    },
    "failure_modes": {
      "type": "array",
      "minItems": 3
    },
    "last_reviewed": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
    }
  }
}
