{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "provider",
    "canonical_url",
    "description",
    "resource_type",
    "access_model",
    "credential_outcome",
    "related_credentials",
    "level",
    "language",
    "hands_on",
    "prompt_engineering_relevance",
    "relevance_rationale",
    "related_lessons",
    "status",
    "last_verified",
    "stale_after_days",
    "stale_risk"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^course-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "provider": {
      "type": "string",
      "minLength": 2
    },
    "canonical_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "description": {
      "type": "string",
      "minLength": 40
    },
    "resource_type": {
      "enum": [
        "structured_course",
        "learning_module",
        "learning_path",
        "interactive_tutorial",
        "guided_lab",
        "workshop",
        "exercise_repository"
      ]
    },
    "access_model": {
      "enum": [
        "free",
        "free_with_account",
        "free_with_optional_paid_completion",
        "paid_one_time",
        "subscription",
        "lab_credits",
        "freemium",
        "employer_or_partner_access",
        "region_dependent",
        "unknown"
      ]
    },
    "credential_outcome": {
      "enum": [
        "no_credential",
        "completion_record",
        "completion_certificate",
        "digital_badge",
        "skill_badge",
        "assessed_skill_credential",
        "applied_skill_credential",
        "professional_certificate_program"
      ]
    },
    "related_credentials": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["credential_id", "relationship"],
        "properties": {
          "credential_id": {
            "type": "string",
            "pattern": "^credential-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "relationship": {
            "enum": [
              "produces",
              "official_preparation",
              "recommended_learning",
              "part_of",
              "overview_of"
            ]
          }
        }
      }
    },
    "level": {
      "enum": ["beginner", "intermediate", "advanced", "mixed"]
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "hands_on": {
      "type": "boolean"
    },
    "prompt_engineering_relevance": {
      "enum": ["direct", "substantial_component", "adjacent", "broad_ai"]
    },
    "relevance_rationale": {
      "type": "string",
      "minLength": 24
    },
    "related_lessons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "status": {
      "enum": ["active", "maintenance", "deprecated"]
    },
    "last_verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "stale_after_days": {
      "type": "integer",
      "minimum": 1
    },
    "stale_risk": {
      "enum": ["low", "medium", "high"]
    }
  }
}
