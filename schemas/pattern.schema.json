{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "slug",
    "name",
    "mechanism",
    "example_prompt",
    "acceptance_criteria",
    "failure_modes",
    "verification",
    "last_reviewed"
  ],
  "properties": {
    "id": {
      "pattern": "^pattern-[a-z0-9-]+$",
      "type": "string"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 3
    },
    "failure_modes": {
      "type": "array",
      "minItems": 3
    },
    "verification": {
      "type": "array",
      "minItems": 2
    },
    "last_reviewed": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
    }
  }
}
