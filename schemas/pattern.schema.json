{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prompt pattern",
  "type": "object",
  "required": [
    "id",
    "slug",
    "name",
    "status",
    "last_reviewed",
    "acceptance_criteria"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^pattern-[a-z0-9-]+$"
    },
    "slug": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "enum": [
        "stable",
        "active",
        "verified"
      ]
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1
    }
  }
}
