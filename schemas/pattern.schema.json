{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "name",
    "title",
    "status",
    "version",
    "last_reviewed",
    "summary",
    "mechanism",
    "use_when",
    "avoid_when",
    "prompt_contract_fields",
    "example_prompt",
    "bad_prompt",
    "why_it_works",
    "acceptance_criteria",
    "failure_modes",
    "verification",
    "related_lessons",
    "related_patterns",
    "trade_offs",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^pattern-[a-z0-9-]+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 4
    },
    "title": {
      "type": "string",
      "minLength": 4
    },
    "status": {
      "type": "string",
      "enum": ["draft", "stable", "deprecated"]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "summary": {
      "type": "string",
      "minLength": 60
    },
    "mechanism": {
      "type": "string",
      "minLength": 100
    },
    "use_when": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 30
      }
    },
    "avoid_when": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 30
      }
    },
    "prompt_contract_fields": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "example_prompt": {
      "type": "string",
      "minLength": 120
    },
    "bad_prompt": {
      "type": "string",
      "minLength": 45
    },
    "why_it_works": {
      "type": "string",
      "minLength": 80
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 35
      }
    },
    "failure_modes": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 60
      }
    },
    "verification": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "type": {
                "const": "normal"
              }
            },
            "required": ["type"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "type": {
                "const": "edge"
              }
            },
            "required": ["type"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "type": {
                "const": "failure"
              }
            },
            "required": ["type"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "scenario",
          "expected_behavior",
          "pass_signal",
          "failure_signal"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["normal", "edge", "failure"]
          },
          "scenario": {
            "type": "string",
            "minLength": 35
          },
          "expected_behavior": {
            "type": "string",
            "minLength": 35
          },
          "pass_signal": {
            "type": "string",
            "minLength": 30
          },
          "failure_signal": {
            "type": "string",
            "minLength": 30
          }
        }
      }
    },
    "related_lessons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\d{2}-[a-z0-9-]+$"
      }
    },
    "related_patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^pattern-[a-z0-9-]+$"
      }
    },
    "trade_offs": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 30
      }
    },
    "tags": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    }
  }
}
