{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "slug",
    "name",
    "official_source_ids",
    "stable_guidance",
    "fast_stale_areas",
    "last_verified",
    "stale_after_days",
    "stale_risk"
  ],
  "properties": {
    "official_source_ids": {
      "type": "array",
      "minItems": 2
    },
    "fast_stale_areas": {
      "type": "array",
      "minItems": 2
    }
  }
}
